{name:"Lutomskie",points:[[52.62,16.20],[52.65,16.23],[52.64,16.27],[52.61,16.25]]},
{name:"Wielkie Żnińskie",points:[[52.85,17.70],[52.88,17.73],[52.87,17.77],[52.84,17.75]]},
{name:"Wąsosze",points:[[52.48,18.42],[52.51,18.45],[52.50,18.49],[52.47,18.47]]}
];

const map=L.map('map').setView([52.1,19.3],6);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
 maxZoom:19,attribution:'&copy; OpenStreetMap contributors'
}).addTo(map);
setTimeout(()=>map.invalidateSize(),250);
window.addEventListener('resize',()=>map.invalidateSize());

const objects=[
 ...rivers.map(obj=>({...obj,type:'rzeka'})),
 ...lakes.map(obj=>({...obj,type:'jezioro'}))
];
const questionDisplay=document.getElementById('question');
const scoreDisplay=document.getElementById('score');
const attemptsDisplay=document.getElementById('attempts');
const progressDisplay=document.getElementById('progress');
const messageDisplay=document.getElementById('message');
const restartBtn=document.getElementById('restartBtn');
const hintBtn=document.getElementById('hintBtn');
let currentIndex=0,score=0,attempts=3,locked=false;

objects.forEach(obj=>{
 obj.solved=false;
 if(obj.type==='rzeka'){
  const visible=L.polyline(obj.points,{color:'#168bd2',weight:4,opacity:0.9}).addTo(map);
  const hit=L.polyline(obj.points,{color:'#168bd2',weight:15,opacity:0.015}).addTo(map);
  visible.on('click',()=>handleClick(obj));
  hit.on('click',()=>handleClick(obj));
  obj.visibleLayer=visible;obj.hitLayer=hit;
 }else{
  const poly=L.polygon(obj.points,{color:'#7651b5',weight:2,fillColor:'#7651b5',fillOpacity:0.4}).addTo(map);
  poly.on('click',()=>handleClick(obj));
  obj.visibleLayer=poly;
 }
});

function updateScore(){
 scoreDisplay.textContent='Punkty: '+score.toFixed(2);
 attemptsDisplay.textContent='Pozostałe próby: '+attempts;
 progressDisplay.textContent='Obiekt '+Math.min(currentIndex+1,objects.length)+' z '+objects.length;
}
function setObjectStyle(obj,color){
 if(obj.type==='rzeka'){
  obj.visibleLayer.setStyle({color});
  obj.hitLayer.setStyle({color,opacity:0.015,weight:15});
 }else obj.visibleLayer.setStyle({color,fillColor:color});
}
function nextQuestion(){
 locked=false;attempts=3;messageDisplay.textContent='';
 if(currentIndex>=objects.length){
  questionDisplay.textContent='Quiz zakończony!';
  attemptsDisplay.textContent='';
  progressDisplay.textContent='Ukończono '+objects.length+' obiektów';
  messageDisplay.textContent='Wynik: '+score.toFixed(2)+' / '+objects.length+' punktów ('+(score/objects.length*100).toFixed(1)+'%).';
  restartBtn.hidden=false;hintBtn.disabled=true;return;
 }
 questionDisplay.textContent='Znajdź na mapie: '+objects[currentIndex].name;
 hintBtn.disabled=false;updateScore();
}
function handleClick(obj){
 if(locked||obj.solved||currentIndex>=objects.length)return;
 const target=objects[currentIndex];
 if(obj===target){
  const earned=attempts===3?1:attempts===2?0.5:0.25;
  score+=earned;obj.solved=true;setObjectStyle(obj,'#218739');
  messageDisplay.textContent='Dobrze! +'+earned+' pkt';
  currentIndex++;locked=true;hintBtn.disabled=true;updateScore();
  setTimeout(nextQuestion,900);
 }else{
  attempts--;
  messageDisplay.textContent=attempts>0?'Źle! Spróbuj ponownie.':'Brak prób!';
  updateScore();
  if(attempts<=0){
   target.solved=true;setObjectStyle(target,'#d93025');
   currentIndex++;locked=true;hintBtn.disabled=true;
   setTimeout(nextQuestion,1100);
  }
 }
}
hintBtn.addEventListener('click',()=>{
 const obj=objects[currentIndex];if(!obj||locked)return;
 if(obj.type==='rzeka'){
  messageDisplay.textContent='Podpowiedź: szukaj niebieskiej linii rzeki.';
  obj.visibleLayer.setStyle({weight:7});
 }else{
  messageDisplay.textContent='Podpowiedź: szukaj fioletowego obszaru jeziora.';
  obj.visibleLayer.setStyle({weight:4,fillOpacity:0.6});
 }
});
restartBtn.addEventListener('click',()=>{
 currentIndex=0;score=0;attempts=3;locked=false;
 objects.forEach(obj=>{
  obj.solved=false;
  if(obj.type==='rzeka'){
   obj.visibleLayer.setStyle({color:'#168bd2',weight:4,opacity:0.9});
   obj.hitLayer.setStyle({color:'#168bd2',weight:15,opacity:0.015});
  }else{
   obj.visibleLayer.setStyle({color:'#7651b5',fillColor:'#7651b5',weight:2,fillOpacity:0.4,opacity:1});
  }
 });
 restartBtn.hidden=true;nextQuestion();
});
nextQuestion();
}
function loadLeaflet(urls){
 if(window.L){startQuiz();return;}
 const url=urls.shift();
 if(!url){
  document.getElementById('map').innerHTML='<div style="padding:20px;text-align:center;font-family:Arial">Nie udało się załadować biblioteki mapy. Sprawdź internet lub uruchom stronę przez GitHub Pages.</div>';
  document.getElementById('question').textContent='Nie udało się uruchomić mapy';return;
 }
 const script=document.createElement('script');
 script.src=url;script.onload=()=>startQuiz();script.onerror=()=>loadLeaflet(urls);
 document.head.appendChild(script);
}
loadLeaflet([
 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js',
 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
]);
</script>
</body>
